# ─── Core ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon/Supabase/managed Postgres or docker compose `db`)
DATABASE_URL="postgresql://banktech:banktech@localhost:5432/banktech?schema=public"

# Public base URL (used for canonical URLs, sitemap, email links)
APP_URL="http://localhost:3000"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Set to true when running behind a proxy you trust (Docker/VPS). Vercel sets this automatically.
AUTH_TRUST_HOST=true

# Seeded admin account (only used by `npm run db:seed`). Change the password before seeding production.
SEED_ADMIN_EMAIL="admin@banktechjobs.local"
SEED_ADMIN_PASSWORD="change-me-admin-password"
# Sample candidate account (S. M. Rafi Alam demo profile)
SEED_DEMO_EMAIL="rafi.demo@banktechjobs.local"
SEED_DEMO_PASSWORD="change-me-demo-password"
# Set to false to skip clearly-labelled demo jobs when seeding
SEED_DEMO_JOBS=true

# ─── Scheduled tasks ─────────────────────────────────────────────────────
# Bearer secret for /api/cron/* (Vercel Cron sends it automatically as Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="replace-with-another-long-random-string"
# Cron expressions, evaluated in Asia/Dhaka. Leave empty to use defaults.
CRON_COLLECT="*/15 * * * *"
CRON_REMINDERS="*/30 * * * *"
CRON_VERIFY_DEADLINES="30 0 * * *"
CRON_CLEANUP="0 3 * * *"
CRON_DIGEST="0 8 * * *"
# Default per-method intervals (minutes); each source can be overridden in the admin panel
INTERVAL_OFFICIAL_MINUTES=120
INTERVAL_FEED_MINUTES=60
INTERVAL_SLOW_MINUTES=360

# ─── Collector politeness ───────────────────────────────────────────────
COLLECTOR_USER_AGENT="BankTechJobsBD/0.1 (+http://localhost:3000/about; job-alert aggregator; contact: admin@banktechjobs.local)"
COLLECTOR_MIN_DELAY_MS=5000
COLLECTOR_MAX_RETRIES=3
COLLECTOR_TIMEOUT_MS=20000
COLLECTOR_CONCURRENCY=3
# Enable Playwright-based sources (requires `npx playwright install chromium` or the worker Docker image)
PLAYWRIGHT_ENABLED=false

# ─── Email (Resend) ─────────────────────────────────────────────────────
# Without RESEND_API_KEY emails are logged to the console and recorded as LOGGED deliveries.
RESEND_API_KEY=""
EMAIL_FROM="BankTech Jobs BD <alerts@example.com>"

# ─── Telegram (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# ─── Web Push (optional) — generate with: npm run vapid ─────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@banktechjobs.local"

# ─── Rate limiting (optional Upstash Redis REST) ────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
