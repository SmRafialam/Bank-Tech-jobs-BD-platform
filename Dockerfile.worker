# syntax=docker/dockerfile:1.7
# ── Worker image: scheduler + collectors (incl. Playwright/Chromium) + migrations/seed ──
# The Playwright base image ships Chromium and its system dependencies; keep its tag in sync with package.json.
FROM mcr.microsoft.com/playwright:v1.63.0-noble
WORKDIR /app
ENV NODE_ENV=production PLAYWRIGHT_ENABLED=true PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
# Dev dependencies are needed for tsx and the prisma CLI (migrate deploy / seed).
RUN npm ci --include=dev
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" npx prisma generate
USER pwuser
CMD ["npx", "tsx", "scripts/worker.ts"]
